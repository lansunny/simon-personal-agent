# Copy to .env; fill the key locally. Never commit your .env.
# Existing environment variables / PyCharm Run Configuration take precedence.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
HENGBAN_PORT=8000
# Optional: override local database directory (use forward slashes on Windows).
# HENGBAN_DATA_DIR=./data

# Optional: Tavily search / Amap Web-service key. Leave blank to disable.
TAVILY_API_KEY=
AMAP_API_KEY=

# 可选：只读HTTPS日历订阅；在网页启用同步后，后端约每分钟检查。
HENGBAN_CALENDAR_ICS_URL=
# 可选：本地手机/通知桥接认证令牌，不要填入聊天。
HENGBAN_EVENT_BRIDGE_TOKEN=

# 可选：通知接收端HTTPS webhook，网页策略开启投递后才使用。
HENGBAN_NOTIFICATION_WEBHOOK_URL=
HENGBAN_NOTIFICATION_WEBHOOK_TOKEN=

# Simon手机连接：默认仅本机。局域网访问需配置受手机信任的HTTPS证书并显式监听网卡。
SIMON_HOST=127.0.0.1
SIMON_SSL_CERTFILE=
SIMON_SSL_KEYFILE=
